# Clay Dark
# 灰阶为底，Clay 点睛。除 Clay 外所有颜色都是 R = G = B 的中性灰。
# 需要 Ghostty 1.3+（search-* 键）。

# 终端自身：正文 fg 在 bg 上
background = #121212
foreground = #cccccc

# 光标：Clay 块，光标下文字用底色
cursor-color = #d97757
cursor-text = #121212

# 选区：bright 在 selection 上
selection-background = #363636
selection-foreground = #e6e6e6

# 搜索匹配：bright 在 search 上，比选区离底色更远
search-background = #424242
search-foreground = #e6e6e6

# 当前搜索匹配：底色在 Clay 上
search-selected-background = #d97757
search-selected-foreground = #121212

# 分屏：分割线用 border；未聚焦分屏向底色褪去
split-divider-color = #2a2a2a
unfocused-split-fill = #121212

# 标题栏（仅 window-theme = ghostty 时生效）：sidebar 退后，次要界面文字
window-titlebar-background = #101010
window-titlebar-foreground = #aaaaaa

# ANSI 16 色：彩色槽位映射回灰阶，只有 red 用 Clay
# 0 black          sidebar
palette = 0=#101010
# 1 red            clay
palette = 1=#d97757
# 2 green          bright
palette = 2=#e6e6e6
# 3 yellow         secondary
palette = 3=#aaaaaa
# 4 blue           secondary
palette = 4=#aaaaaa
# 5 magenta        muted
palette = 5=#8e8e8e
# 6 cyan           secondary
palette = 6=#aaaaaa
# 7 white          fg
palette = 7=#cccccc
# 8 bright black   comment
palette = 8=#7a7a7a
# 9 bright red     clay
palette = 9=#d97757
# 10 bright green  bright
palette = 10=#e6e6e6
# 11 bright yellow fg
palette = 11=#cccccc
# 12 bright blue   fg
palette = 12=#cccccc
# 13 bright magenta secondary
palette = 13=#aaaaaa
# 14 bright cyan   fg
palette = 14=#cccccc
# 15 bright white  bright
palette = 15=#e6e6e6
